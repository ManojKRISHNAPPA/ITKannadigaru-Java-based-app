pipeline{
    agent any 
    
    tools {
        jdk 'java-17'
        maven 'maven'
    }
    environment {
        IMAGE_NAME = "afeef96867-hub/itkannadigaru-blogpost:${GIT_COMMIT}"
    }
    
    stages {
        stage ('git-checkout') {
            steps {
               git url: 'https://github.com/afeef96867-hub/ITKannadigaru-Java-based-app.git',branch:'prod1'
            }
        }
        stage ('compile') {
            steps {
                sh '''
                mvn compile
                '''
            } 
        }
        stage ('packaging') {
            steps {
                sh '''
                mvn clean package
                '''
            }
        }
        stage ('docker-build') {
            steps {
                sh '''
                docker build -t ${IMAGE_NAME} .
                '''
            }
        }
        stage ('docker-testing') {
            steps {
                sh '''
                docker rm -f itkannadigaru-blogpost-test || true
                docker run -t -d --name itkannadigaru-blogpost-test -p 9000:8080 ${IMAGE_NAME} 
                '''
            }
        }
    }
}
